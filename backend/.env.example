# Copia este archivo como .env y completa los valores de tu proyecto Neon.
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Guatemala
APP_URL=https://equipo.gobernacionbajaverapaz.gob.gt
FRONTEND_ORIGIN=https://equipo.gobernacionbajaverapaz.gob.gt

# Neon: copia los valores de Connection Details. No incluyas "postgresql://" en DB_HOST.
DB_HOST=ep-tu-proyecto-pooler.region.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=tu_usuario_neon
DB_PASSWORD=CAMBIAR_POR_LA_CLAVE_DE_NEON
DB_SSLMODE=require

JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_64_CARACTERES
JWT_ISSUER=reservas-institucional
JWT_TTL_MINUTES=60
LOG_PATH=storage/logs
